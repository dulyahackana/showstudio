{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/routeTree.gen.ts",
      "!contracts",
      "!test-vectors",
      "!samples",
      "!**/components/ui",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error", "useTemplate": "off" },
      "complexity": { "noForEach": "off", "noVoid": "off" },
      "suspicious": { "noArrayIndexKey": "off", "noConfusingVoidType": "off" },
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off", "noLabelWithoutControl": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
